# Copy this file to .env.local for local development and fill in real values.
# In production these are set as Cloudflare Workers secrets/vars - see
# wrangler.toml and README.md for the `wrangler secret put` commands.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Not required: the app redirects to Stripe's hosted Checkout page, so no
# publishable key is ever used in the browser. Left here only so nobody
# wonders whether it is missing.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

OPENAI_API_KEY=

# A bcryptjs hash, never a plaintext password.
ADMIN_PASSWORD_HASH=
# 32 or more random bytes, the HMAC key for the admin session cookie.
ADMIN_SESSION_SECRET=
# The shared-secret header value for the cron routes.
CRON_SECRET=
# 32 or more random bytes, HMAC key used to pseudonymize IPs before they're
# ever stored (reserved_by_ip_hash, reporter_ip_hash). Never the raw SHA-256
# of an IP alone - that's reversible via brute force over the IPv4 space.
IP_HASH_SECRET=

